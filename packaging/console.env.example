# Optional overrides. Leave unset to manage these fields from console Settings.
# Installed Windows: C:\ProgramData\AidotVPN\console\config\console.env
# Installed Linux: /etc/aidotvpn/console.env
# Source build: project .env
# CONSOLE_BIND_HOST=0.0.0.0
# CONSOLE_PORT=9111
# CONSOLE_HTTPS_ENABLED=true
# CONSOLE_PUBLIC_URL=https://vpn.example.com:9111
# CONSOLE_TLS_CERT_FILE=C:\ProgramData\AidotVPN\console\certs\fullchain.pem
# CONSOLE_TLS_KEY_FILE=C:\ProgramData\AidotVPN\console\certs\privkey.pem
# Linux PEM paths: /etc/aidotvpn/certs/fullchain.pem and privkey.pem
# Certificate SAN must cover the hostname; the service must be able to read both files.
# Never disable certificate validation. Install your organization CA in clients' trust store.
