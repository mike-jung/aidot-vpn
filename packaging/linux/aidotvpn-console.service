[Unit]
Description=AidotVPN console
After=network.target aidotvpn-controller.service
[Service]
Type=simple
User=aidotvpn
Group=aidotvpn
Environment=AIDOTVPN_SCOPE=system
WorkingDirectory=/var/lib/aidotvpn
ExecStart=/opt/aidotvpn/aidotvpn-console
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
StateDirectory=aidotvpn
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/aidotvpn
# V8 generates machine code: MemoryDenyWriteExecute is deliberately not enabled.
[Install]
WantedBy=multi-user.target
