[Unit]
Description=AidotVPN controller
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/aidotvpn/controller.env
[Service]
Type=simple
User=aidotvpn
Group=aidotvpn
Environment=AIDOTVPN_ENV_FILE=/etc/aidotvpn/controller.env
WorkingDirectory=/var/lib/aidotvpn
ExecStart=/opt/aidotvpn/aidotvpn-controller
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/aidotvpn
[Install]
WantedBy=multi-user.target
