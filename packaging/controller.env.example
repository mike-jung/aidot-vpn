# Copy to the configuration directory as controller.env, restrict access, then edit.
# No credentials are included. Use an existing dedicated MariaDB database/user.
CONTROLLER_HTTP_LISTEN=127.0.0.1:10030
CONTROLLER_GRPC_LISTEN=127.0.0.1:10021
AIDOTVPN_DB_HOST=127.0.0.1
AIDOTVPN_DB_PORT=3306
AIDOTVPN_DB_NAME=aidotvpn
AIDOTVPN_DB_USER=
AIDOTVPN_DB_PASSWORD=
AIDOTVPN_DB_TLS=required
# Keep this randomly generated encryption key stable and back it up securely.
SETTINGS_ENCRYPTION_KEY=
AIDOTVPN_ADMIN_EMAIL=
AIDOTVPN_ADMIN_PASSWORD=
# Absolute paths required when using AIDOTVPN_ENV_FILE. Preserve across upgrades.
AIDOTVPN_CA_CERT_FILE=
AIDOTVPN_CA_KEY_FILE=
