# AidotVpn console environment.
#
# Variables prefixed with VITE_ are baked into the SPA at `npm run build`
# and become visible to the browser. Do NOT put secrets in those.
#
# Variables WITHOUT the VITE_ prefix are used by server.js only.

# --- SPA build-time config (browser-visible) ---

# Keycloak realm issuer URL.
# Tip: must match `iss` claim emitted by Keycloak; with the default realm
# import that's http://localhost:9110/realms/aidotvpn .
VITE_OIDC_ISSUER=http://localhost:9110/realms/aidotvpn

# Public OIDC client ID for the console. Must be registered in Keycloak
# with PKCE enabled and no client secret.
VITE_OIDC_CLIENT_ID=aidotvpn-admin-console

# Redirect URI registered in Keycloak. Default: <origin>/login. Override
# only if you serve the console under a path prefix.
# VITE_OIDC_REDIRECT_URI=https://admin.aidotvpn.example/login

# --- server.js runtime config ---

# Bind address + port for the Express server. 0.0.0.0:8091 in container.
PORT=8091
BIND_HOST=0.0.0.0

# Controller upstream. server.js proxies /api/* here.
CONTROLLER_URL=http://controller:10030
