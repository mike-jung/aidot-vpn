# AidotVPN Public evaluation settings. Copy to .env and set unique passwords.
# Never commit .env. See docs/getting-started.md and docs/https.md.
MARIADB_ROOT_PASSWORD=replace_with_a_unique_password
MARIADB_HOST_PORT=4336
AIDOTVPN_DB_NAME=aidotvpn
AIDOTVPN_DB_USER=aidotvpn
AIDOTVPN_DB_PASSWORD=replace_with_a_unique_password
AIDOTVPN_ADMIN_EMAIL=admin@aidot-link.com
AIDOTVPN_ADMIN_PASSWORD=replace_with_a_unique_password
CONSOLE_PORT=6193
GATEWAY_HEALTH_PORT=10140
WG_DATAPLANE_PORT=52840
CONSOLE_BIND_HOST=127.0.0.1
WG_BIND_ADDR=0.0.0.0
AIDOTVPN_ENABLE_DEV_ADMIN=false
AIDOTVPN_ALLOW_DEV_ADMIN_PUBLIC=true
CONTROLLER_HTTP_LISTEN=0.0.0.0:10030
CONTROLLER_GRPC_LISTEN=0.0.0.0:10021
CONTROLLER_LOG_LEVEL=info
AIDOTVPN_DB_HOST=127.0.0.1
AIDOTVPN_DB_PORT=4336
AIDOTVPN_DB_TLS=disable
CONTROLLER_WG_IPV4_POOL=10.78.0.0/16
CONTROLLER_WG_IPV6_POOL=fd5e:7c2a:d8e1::/48
CONTROLLER_URL=http://localhost:10030
FAKE_ENGINE=true
SYNC_INTERVAL=30s
HEALTH_ADDR=127.0.0.1:10140
AIDOTVPN_PUBLIC_ENDPOINT_HOST=
AIDOTVPN_PUBLIC_ENDPOINT_PORT=52840
DDNS_PROVIDER=cloudflare
DDNS_DOMAIN=
DDNS_CLOUDFLARE_TOKEN=
DDNS_CLOUDFLARE_ZONE=
DDNS_INTERVAL=5m
GATEWAY_NODE_TOKEN=
RELAY_URL=
GATEWAY_CONTROLLER_URL=http://host.docker.internal:10030
ENROLLMENT_PASSWORD=aidot1234
SETTINGS_ENCRYPTION_KEY=

# Configure console HTTPS with: npm run https:cert
# CONSOLE_HTTPS_ENABLED=true
# CONSOLE_PUBLIC_URL=https://localhost:6193
# CONSOLE_TLS_CERT_FILE=".local/https/fullchain.pem"
# CONSOLE_TLS_KEY_FILE=".local/https/privkey.pem"
